# =============================================================================
# LegalVision Paid Media Reporting Dashboard — environment variables
# Copy to .env.local (never commit real values). Every var is documented here.
# The app runs fully on isolated mock data until real credentials are supplied.
# =============================================================================

# ---- Run mode ---------------------------------------------------------------
# PRODUCTION: set MOCK_MODE=false and USE_REAL_DATA=true (serve real platform data).
# 'true' (default) serves the isolated mock warehouse (rows tagged source='mock').
MOCK_MODE=false
USE_REAL_DATA=true

# Consolidated reporting currency for All-markets rollups (A3). Default AUD.
REPORTING_CURRENCY=AUD

# ---- Database (Supabase Postgres, AU region ap-southeast-2) ------------------
# Pooled connection string for the app; direct string for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# ---- Supabase Auth / Storage ------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=            # anon key — RLS-guarded, safe for browser
SUPABASE_SERVICE_ROLE_KEY=                # SERVER ONLY — used by sync jobs; never exposed
SUPABASE_STORAGE_BUCKET=lv-assets         # creative thumbnails, logos, exports (private)

# ---- Extraction layer: Windsor.ai (account `zeemarketing`, PAID plan) --------
# Single read key for both Google Ads + Meta connectors across all six accounts.
WINDSOR_API_KEY=

# ---- Meta Marketing API (creative previews; direct-insights fallback) --------
# System-user token via a Business Manager with access to AU/UK/NZ ad accounts.
# BLOCKING for Meta NZ (A11): personal-profile token is insufficient for production.
META_SYSTEM_USER_TOKEN=
META_APP_ID=
META_APP_SECRET=

# ---- Live-lead source (CRM / call tracking) — TBD (§31.C) --------------------
# Until confirmed, the LeadSourceAdapter stub keeps Lead Quality in v1 mode and
# Meta live-lead columns render "—" (never 0).
LEAD_SOURCE_SYSTEM=                        # e.g. hubspot | salesforce | calltracker
LEAD_SOURCE_API_KEY=
LEAD_SOURCE_BASE_URL=

# ---- FX (frankfurter.app ECB daily) — no key required -----------------------
# Documented for completeness; the FxAdapter needs no secret.

# ---- Live Leads conversion-action mapping (A1) ------------------------------
# Default action name is "Live Leads" in all three Google accounts; admin-mappable
# in-app, so these are seed defaults only.
LIVE_LEADS_ACTION_NAME_AU=Live Leads
LIVE_LEADS_ACTION_NAME_UK=Live Leads
LIVE_LEADS_ACTION_NAME_NZ=Live Leads

# ---- Monitoring & ops -------------------------------------------------------
SENTRY_DSN=
CRON_SECRET=                               # shared secret guarding /api/cron/* routes
ALERT_NOTIFY_EMAIL=agency@zeemarketing.com # sync-failure notifications (after ×2)
ALERT_NOTIFY_SLACK_WEBHOOK=

# ---- App ---------------------------------------------------------------------
APP_DOMAIN=reporting.legalvision.com.au
ADMIN_CONTACT_EMAIL=agency@zeemarketing.com  # shown on the 403 page
RESEND_API_KEY=                              # invites / resets / digests

# ClickUp personal API token (avatar -> Settings -> Apps -> Generate API token, pk_...)
# Enables live refresh of the 90-Day Plan ClickUp activity panel.
CLICKUP_API_TOKEN=
